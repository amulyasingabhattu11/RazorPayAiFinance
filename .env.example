# Copy this to .env and fill in your key
# If left blank, the agent will run in STUB mode (no real LLM calls)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Matching thresholds
FEE_TOLERANCE_INR=1.0
AGENT_MATCH_THRESHOLD=0.90
AGENT_REVIEW_THRESHOLD=0.70

# Synthetic data seed (keeps runs deterministic)
RANDOM_SEED=42
